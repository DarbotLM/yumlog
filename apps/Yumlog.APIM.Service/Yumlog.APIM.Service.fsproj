<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\Yumlog.Dotnet.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(YumlogDotnetTfm)-windows</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Yumlog.APIM.Service</AssemblyName>
    <RootNamespace>Yumlog.APIM.Service</RootNamespace>
    <Version>0.7.1</Version>
    <AssemblyVersion>0.7.1.0</AssemblyVersion>
    <FileVersion>0.7.1.0</FileVersion>
    <Authors>Darbot Labs</Authors>
    <Description>Windows Service foundation for Yumlog APIM orchestration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="$(YumlogExtensionsVersion)" />
  </ItemGroup>

</Project>
