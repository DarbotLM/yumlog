<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Yumlog.Dotnet.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(YumlogDotnetTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Yumlog.WidgetStudio</AssemblyName>
    <RootNamespace>Yumlog.WidgetStudio</RootNamespace>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <Authors>Darbot Labs</Authors>
    <Description>Widget Studio authoring, validation, preview, and package skeleton for adaptive Yumlog LiveTile widgets.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Schemas\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Samples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Regression fixtures run in self-test but never ship in the release package. -->
    <Content Update="Samples\fixtures\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
