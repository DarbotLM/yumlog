<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Yumlog.Dotnet.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(YumlogDotnetTfm)-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Paperboy</AssemblyName>
    <RootNamespace>Paperboy.Desktop</RootNamespace>
    <ApplicationIcon />
    <Version>0.7.1</Version>
    <AssemblyVersion>0.7.1.0</AssemblyVersion>
    <FileVersion>0.7.1.0</FileVersion>
    <Authors>Darbot Labs</Authors>
    <Description>Windows-native .NET 11 Paperboy bundle courier for tossable .paperboy.zip archives.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
