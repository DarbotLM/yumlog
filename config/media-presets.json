  "reviewWorkflows": [
    {
      "id": "standard-narration",
      "label": "Standard narration review",
      "asrModel": "base.en",
      "maxWordErrorRate": 0.08,
      "maxSamplePeakDbfs": -1,
      "maxClippedSamples": 0,
      "silence": {
        "thresholdDb": -50,
        "minimumSeconds": 0.3,
        "maxInternalSeconds": 1.5,
        "maxLeadingSeconds": 1,
        "maxTrailingSeconds": 2
      },
      "loudnessToleranceLu": 1.5,
      "durationTolerance": 0.1,
      "voiceDistinctness": {
        "maxBlendSimilarity": 0.9,
        "minMedianF0SeparationHz": 20
      }
    },
    {
      "id": "short-form",
      "label": "Short-form review",
