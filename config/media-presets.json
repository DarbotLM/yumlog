  "semantics": {
    "duration": "An authoring or recording target. Always measure actual duration; never silently pad, truncate or accelerate speech.",
    "frameRate": "Exact rational rate. Adapters must reject unsupported rates explicitly.",
    "resolution": "Output dimensions; fitting must preserve aspect ratio unless an explicit crop is selected.",
    "audioProfile": "Loudness target (integrated LUFS, true-peak ceiling, loudness range) applied with FFmpeg loudnorm, plus the delivery sample format and codec. agent names the default agentPresets voice.",
    "videoProfile": "Encoder settings for delivery. HEVC/libx265 is the default; H.264/libx264 is supported for compatibility. maxBitrateKbps/bufferKbps cap the CRF encode (VBV).",
    "captionStyle": "Burned-in caption look at a 1080-pixel reference on the short side of the frame, so landscape and portrait captions render the same pixel size. maxCharsPerLine/maxLines drive caption chunking and are enforced by media-review.",
    "pipeline": "Ordered stages: script, voice, render, mix, encode, review. Audio-only pipelines omit render and carry no videoProfile.",
    "agentPresets": "Mirror of the Gen-Audio voices/agents blends that a2swe renders: each a2sweAgent names the voice-profiles.json agent whose profile carries the same blend, speed and engine. Gen-Audio-only persona blends are not listed.",
    "reviewWorkflow": "Measured acceptance thresholds. media-review transcribes the delivery with faster-whisper (asrModel, local files only) for WER. A check whose metric is not measured is reported as not_measured and fails the workflow; nothing passes by default."
  }
}
