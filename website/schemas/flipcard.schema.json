{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darbotlm.github.io/yumlog/schemas/flipcard.schema.json",
  "title": "Yumlog documentation flipcard",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "id", "section", "layer", "name", "url", "front", "back", "source"],
  "properties": {
    "kind": {"const": "YumlogWikiFlipCard"},
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^yumlog\\.wiki\\.[a-z-]+\\.[a-z-]+$"},
    "section": {"type": "string"},
    "layer": {"enum": ["title", "overview", "instructions", "format-outputs", "agents-tools", "sdk-examples"]},
    "name": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "front": {
      "type": "object", "additionalProperties": false, "required": ["title", "blocks"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/block"}}
      }
    },
    "back": {
      "type": "object", "additionalProperties": false,
      "required": ["adaptiveCard", "agentCard", "history", "framework"],
      "properties": {
        "adaptiveCard": {"allOf": [
          {"$ref": "http://adaptivecards.io/schemas/adaptive-card.json"},
          {"properties": {"version": {"const": "1.5"}}, "required": ["version"]}
        ]},
        "agentCard": {"allOf": [
          {"$ref": "https://ac3.one/schemas/copilot-studio/agent-card/3.1/agent-card.schema.json"},
          {"properties": {"schemaVersion": {"const": "3.1"}}, "required": ["schemaVersion"]}
        ]},
        "history": {
          "type": "object", "required": ["scope", "limit", "shallow", "entries"],
          "properties": {
            "scope": {"type": "string"}, "limit": {"const": 5}, "shallow": {"type": "boolean"},
            "entries": {"type": "array", "items": {
              "type": "object", "required": ["commit", "date", "subject", "url"],
              "properties": {
                "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "date": {"type": "string", "format": "date-time"},
                "subject": {"type": "string"},
                "url": {"type": "string", "format": "uri"}
              }, "additionalProperties": false
            }}
          }, "additionalProperties": false
        },
        "framework": {
          "type": "object", "required": ["documentationOnly", "adaptiveCardVersion", "agentCardVersion", "inputs", "outputs", "documentedActions", "references"],
          "properties": {
            "documentationOnly": {"const": true},
            "adaptiveCardVersion": {"const": "1.5"},
            "agentCardVersion": {"const": "3.1"},
            "inputs": {"type": "array", "items": {"type": "string"}},
            "outputs": {"type": "array", "items": {"type": "string"}},
            "documentedActions": {"type": "array", "items": {"type": "string"}},
            "references": {"type": "array", "items": {"type": "string", "format": "uri"}}
          }, "additionalProperties": false
        }
      }
    },
    "source": {
      "type": "object", "required": ["path", "sha256", "buildCommit", "workingTreeModified", "releaseVersion"],
      "properties": {
        "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "buildCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "workingTreeModified": {"type": "boolean"}, "releaseVersion": {"type": "string"}
      }, "additionalProperties": false
    }
  },
  "definitions": {
    "inline": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["text", "inlineCode", "strong", "emphasis", "delete", "link", "break"]},
        "value": {"type": "string"}, "url": {"type": "string", "format": "uri"},
        "children": {"type": "array", "items": {"$ref": "#/definitions/inline"}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["text", "inlineCode"]}}}, "then": {"required": ["value"]}},
        {"if": {"properties": {"type": {"enum": ["strong", "emphasis", "delete", "link"]}}}, "then": {"required": ["children"]}},
        {"if": {"properties": {"type": {"const": "link"}}}, "then": {"required": ["url"]}}
      ]
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["heading", "paragraph", "code", "list", "table"]},
        "id": {"type": "string"}, "depth": {"type": "integer", "minimum": 2, "maximum": 6},
        "children": {"type": "array", "items": {"$ref": "#/definitions/inline"}},
        "value": {"type": "string"}, "language": {"type": "string"},
        "ordered": {"type": "boolean"}, "start": {"type": "integer", "minimum": 1},
        "items": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/definitions/block"}}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/definitions/inline"}}}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "heading"}}}, "then": {"required": ["id", "depth", "children"]}},
        {"if": {"properties": {"type": {"const": "paragraph"}}}, "then": {"required": ["children"]}},
        {"if": {"properties": {"type": {"const": "code"}}}, "then": {"required": ["value", "language"]}},
        {"if": {"properties": {"type": {"const": "list"}}}, "then": {"required": ["ordered", "start", "items"]}},
        {"if": {"properties": {"type": {"const": "table"}}}, "then": {"required": ["rows"]}}
      ]
    }
  }
}
