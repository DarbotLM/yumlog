<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reflection-based Studio smoke host: drives Yumlog.Native's Studio workspace
       (import, clip, frames, scenes, audio, captions, OCR, card export, bundle) and
       can host the Studio UI for the Playwright check in check-ui.mjs. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\apps\Yumlog.Native\Yumlog.Native.fsproj" />
  </ItemGroup>
</Project>
